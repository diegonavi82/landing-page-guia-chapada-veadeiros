# Guia Chapada Veadeiros — .htaccess raiz

Options -Indexes

# Proteger arquivos sensíveis
<FilesMatch "^(\.env|config\.local\.php|composer\.json|composer\.lock)$">
  Order allow,deny
  Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Home em Markdown quando o agente pede text/markdown
  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteRule ^$ /index.md [L]

  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteRule ^index\.html$ /index.md [L]

  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteRule ^en/?$ /en/index.md [L]

  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteRule ^en/index\.html$ /en/index.md [L]

  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteRule ^es/?$ /es/index.md [L]

  RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
  RewriteRule ^es/index\.html$ /es/index.md [L]

  # MCP streamable HTTP
  RewriteRule ^mcp/?$ /mcp/index.php [L]

  # Nomes que o exame de visibilidade procura: about, contact, privacy, terms
  RewriteRule ^about/?$ /sobre.html [L]
  RewriteRule ^contact/?$ /contato.html [L]
  RewriteRule ^privacy/?$ /privacidade.html [L]
  RewriteRule ^terms/?$ /termos.html [L]
  RewriteRule ^en/about/?$ /en/sobre.html [L]
  RewriteRule ^en/contact/?$ /en/contato.html [L]
  RewriteRule ^en/privacy/?$ /en/privacidade.html [L]
  RewriteRule ^en/terms/?$ /en/termos.html [L]
  RewriteRule ^es/about/?$ /es/sobre.html [L]
  RewriteRule ^es/contact/?$ /es/contato.html [L]
  RewriteRule ^es/privacy/?$ /es/privacidade.html [L]
  RewriteRule ^es/terms/?$ /es/termos.html [L]

  # Link headers com aspas reais (o LiteSpeed não remove a barra de \")
  RewriteRule ^ - [E=GCV_LINK_LLMS:<https://www.guiachapadaveadeiros.com/llms.txt>;rel="describedby";type="text/markdown",E=GCV_LINK_MD:<https://www.guiachapadaveadeiros.com/index.md>;rel="alternate";type="text/markdown"]

  # Bloquear acesso direto a vendor
  RewriteRule ^api/vendor/ - [F,L]

  # Link da saída: prévia própria (arara + foto do guia) e cai no card de reserva
  RewriteRule ^(en|es)/s/([a-z0-9][a-z0-9-]{0,180})/?$ /api/saida-share.php?lang=$1&id=$2 [L,QSA,NC]
  RewriteRule ^s/([a-z0-9][a-z0-9-]{0,180})/?$ /api/saida-share.php?lang=pt&id=$1 [L,QSA,NC]

  # URLs sem extensão → .html (ex: /login → /login.html)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]

  # Diretórios com index.html (ex: /dashboard/ → /dashboard/index.html)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]
</IfModule>

AddType text/markdown .md
AddType application/json .json

# Headers de segurança
<IfModule mod_headers.c>
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-XSS-Protection "1; mode=block"
  Header set Content-Signal "search=yes, ai-input=yes, ai-train=yes"
  Header merge Vary Accept
  Header add Link "%{GCV_LINK_LLMS}e" env=GCV_LINK_LLMS
  Header add Link "%{GCV_LINK_MD}e" env=GCV_LINK_MD
  Header add Link "%{REDIRECT_GCV_LINK_LLMS}e" env=REDIRECT_GCV_LINK_LLMS
  Header add Link "%{REDIRECT_GCV_LINK_MD}e" env=REDIRECT_GCV_LINK_MD
  <FilesMatch "\.(css|js|mjs|webp|avif|jpe?g|png|gif|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
