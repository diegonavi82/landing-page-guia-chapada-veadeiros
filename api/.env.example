DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.guiachapadaveadeiros.com/api/auth/google-callback.php
# Places Autocomplete (admin → Cidades). Ative Places API (New) no Google Cloud.
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=
# Stripe Checkout (cartão).
# Segredo fica só no servidor: sk_test_…, sk_live_… ou chave restrita rk_live_… (produção).
# Publicável pode ir no navegador: pk_test_… ou pk_live_…
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Stripe webhook (Desenvolvedores → Webhooks → endpoint /api/stripe_webhook.php → Signing secret whsec_…)
STRIPE_WEBHOOK_SECRET=
# Mercado Pago — Checkout Transparente (formulário de cartão embutido + pré-autorização)
# Teste: credenciais de teste da aplicação; produção: credenciais de produção (só no servidor).
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
MP_APP_ID=6071222836069347
# Webhooks do MP → assinatura secreta (valida x-signature)
MP_WEBHOOK_SECRET=

# ---- Preço por forma de pagamento (ver docs/PAGAMENTOS.md) ----
# Pix = valor do tarifário. Cartão nacional (MP) = +15% em até 4x sem juros.
PAY_CARD_BR_PCT=15
PAY_MP_MAX_INSTALLMENTS=4
# Cartão internacional (Stripe) = +25%, cobrado em dólar pela PTAX do dia + 4% de spread.
PAY_CARD_INTL_PCT=25
PAY_FX_SPREAD_PCT=4
PAY_INTL_CURRENCY=usd
# Tarifa do Pix no Sicoob (% estimado, só para o registro de transações)
PAY_PIX_FEE_PCT=0
# CNPJ da empresa (reconhece a transferência Mercado Pago → Sicoob no extrato Pix)
PAY_OWN_CNPJ=24354289000105
# 1 = recusa compra se o preço enviado pelo navegador divergir do banco (padrão 0 = aceita e marca para revisão)
PAY_STRICT_PRICE_CHECK=0

# ---- Pré-autorização (cartão só é cobrado quando o passeio confirma) ----
# Dias antes da saída em que o valor é reservado no cartão (a reserva vence: Stripe 7d, MP 5d)
PAY_STRIPE_AUTH_DAYS=6
PAY_MP_AUTH_DAYS=4
# Sem quórum + confirmação do guia até X horas antes da saída → libera o cartão (nada cobrado)
PAY_DECISION_HOURS=12
# Prazo para o cliente confirmar o cartão quando precisa (link por e-mail)
PAY_CARD_CONFIRM_DEADLINE_HOURS=48
# Alerta ao admin quando faltar X horas e o guia não confirmou
PAY_GUIDE_ALERT_HOURS=24
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=contato@guiachapadaveadeiros.com
SMTP_PASS=
SMTP_FROM=contato@guiachapadaveadeiros.com
APP_URL=https://www.guiachapadaveadeiros.com
APP_SECRET=
# Aviso de cada compra Pix confirmada (vírgula = vários destinatários)
PURCHASE_NOTIFY_EMAILS=diegonavi82@gmail.com,contato@guiachapadaveadeiros.com
# Compatível com valor único (ou lista separada por vírgula)
# PURCHASE_NOTIFY_EMAIL=diegonavi82@gmail.com
PURCHASE_NOTIFY_WHATSAPP=5562982506891
# Envio automático de WhatsApp (agência → guia em cada venda).
# Recomendado: Z-API conectado no número 62 98250-6891
# ZAPI_INSTANCE_ID=
# ZAPI_TOKEN=
# ZAPI_CLIENT_TOKEN=
# Alternativa: Evolution API
# EVOLUTION_API_URL=
# EVOLUTION_API_KEY=
# EVOLUTION_INSTANCE=
# Fallback só para o celular da agência (CallMeBot):
# CALLMEBOT_APIKEY=
# CALLMEBOT_PHONE=5562982506891
